# Datastar/Litestar port of the panel bidding quiz.
#
# Reachable from the repo root as a just module (`mod dsquiz 'apps/datastar-quiz'` there):
#     just dsquiz serve, just dsquiz test, ...
#
# SHELL, as in deal-simulations/odin-sims: `cmd.exe` starts in ~9ms and is always available, and just
# launches a shell per recipe line.
#  - alternatives: `nu -c` ~41ms, `powershell -NoLogo -NoProfile -Command` ~143ms
#  - cost: poor language for a multi-line recipe, hence `[script]` -> python for anything with logic
[windows]
set shell := ["cmd.exe", "/c"]
[unix]
set shell := ["bash", "-c"]
set minimum-version := "1.49.0"  # [script] (1.49); also [group] 1.27, set lazy 1.47
set unstable  # [script]
set lazy
# `python` alone is not a reliable cross-platform lookup (cf. python/python3/python3.x). uv resolves
# and downloads on every platform, and --no-project means no pyproject.toml / local .venv lookup --
# these scripts are justfile plumbing, NOT part of the app's environment. Recipes opt in with the
# bare `[script]` attribute (no interpreter argument).
set script-interpreter := ["uv", "run", "--no-project", "-p", "3.14", "python"]

# `source_directory()`, NOT `justfile_directory()`: when this file is used as a module from the repo
# root (`just dsquiz test`), `justfile_directory()` is the ROOT justfile's directory, so `--project`
# pointed uv at the root project and every import failed. `source_directory()` is this file's own
# directory either way.
project := source_directory()
repo := parent_directory(parent_directory(source_directory()))
port := env_var_or_default("DSQUIZ_PORT", "5008")
bml_home := env_var_or_default("BML_TOOLS_DIRECTORY", join(home_directory(), "dev", "bml"))
datastar_home := env_var_or_default("DATASTAR_HOME", join(home_directory(), "dev", "datastar"))
deploy_dir := env_var_or_default("DSQUIZ_DEPLOY_DIR", "X:/quiz-ds/")

# `just --choose` builds its own chooser command and SINGLE-quotes the preview:
#     fzf --multi --preview 'just --unstable --color always --justfile "..." --show {}'
# cmd.exe does not treat `'` as a quote, so fzf received `--unstable` as an option of its own and died
# with "unknown option: --unstable" -- the chooser, not just, was doing the complaining. Double quotes
# are what cmd honours (measured inside cmd: the double-quoted form previews, the single-quoted form
# exits 2), and bash honours them too, so one string serves both.
#
# `[script]` because the value has quotes inside quotes: python hands `just` an argv list and the
# chooser as an environment variable, so no shell has to be talked out of re-parsing it. There is no
# `set chooser` -- it is `--chooser` or `JUST_CHOOSER` -- and `setdefault` leaves a JUST_CHOOSER you
# have set yourself alone.
# ---
# interactive chooser (assumes fzf)
[group('dev')]
[script]
default:
	import os, subprocess

	justfile = r"{{ join(source_directory(), 'justfile') }}"
	env = {**os.environ}
	env.setdefault("JUST_CHOOSER", 'fzf --multi --preview "just --justfile ' + justfile + ' --show {}"')
	try:
		rc = subprocess.run(["just", "--justfile", justfile, "--choose"], env=env).returncode
	except KeyboardInterrupt:
		rc = 130
	raise SystemExit(rc)

# serve under granian with autoreload; panel is on 5006, so default to 5008
[group('serve')]
serve *args:
	uv run --project {{project}} --directory {{project}} granian --interface asgi --port {{port}} --reload {{args}} app:app

alias s := serve

# serve with the debug panel armed for every session: +/- points, set the goal, jump to the reveal or
# the finale. Without this you can still arm it per session with `?debug` on the URL; `DSQUIZ_DEBUG=0`
# forbids both (what a deployment should set -- see DEPLOY.md).
#
# `[script]` for the sake of ONE environment variable, because there is no portable one-liner for it:
# cmd.exe wants `set "X=1" && ...` and bash wants `X=1 ...`, and `uv run` has only `--env-file`. The
# other env-setting serve recipes below are the same shape.
# ---
# serve with the debug panel armed for every session
[group('serve')]
[script]
dev *args:
	import os, subprocess

	argv = [
		"uv", "run", "--project", r"{{project}}", "--directory", r"{{project}}",
		"granian", "--interface", "asgi", "--port", r"{{port}}", "--reload",
		*r'''{{args}}'''.split(), "app:app",
	]
	try:
		rc = subprocess.run(argv, env={**os.environ, "DSQUIZ_DEBUG": "1"}).returncode
	except KeyboardInterrupt:
		rc = 130  # a server is stopped with ctrl-c; that is not a traceback
	raise SystemExit(rc)

alias d := dev

# serve with the held-SSE countdown instead of the client interval (see COMPARISON.md)
[group('serve')]
[script]
serve-streamed *args:
	import os, subprocess

	argv = [
		"uv", "run", "--project", r"{{project}}", "--directory", r"{{project}}",
		"granian", "--interface", "asgi", "--port", r"{{port}}", "--reload",
		*r'''{{args}}'''.split(), "app:app",
	]
	try:
		rc = subprocess.run(argv, env={**os.environ, "DSQUIZ_TIMER": "stream"}).returncode
	except KeyboardInterrupt:
		rc = 130
	raise SystemExit(rc)

# serve under granian as in production: no reload, and pick up worker/runtime defaults
[group('serve')]
serve-prod *args:
	uv run --project {{project}} --directory {{project}} granian --interface asgi --host 0.0.0.0 --port {{port}} {{args}} app:app

# serve under uvicorn via the litestar CLI: the pure-python fallback (e.g. FreeBSD, no granian wheels)
[group('serve')]
serve-uvicorn *args:
	uv run --project {{project}} --directory {{project}} litestar --app app:app run --port {{port}} --reload {{args}}

# what the deployment box runs (see DEPLOY.md): uvicorn, no reload, no dev group, prefixed and with
# the debug panel forbidden. Useful locally to rehearse the real thing -- http://localhost:5008/bridge-system-quiz/
# ---
# serve exactly as the deployment box does (prefixed, no reload, debug forbidden)
[group('serve')]
[script]
serve-deployed *args:
	import os, subprocess

	argv = [
		"uv", "run", "--project", r"{{project}}", "--directory", r"{{project}}", "--no-dev",
		"litestar", "--app", "app:app", "run", "--port", r"{{port}}", *r'''{{args}}'''.split(),
	]
	env = {**os.environ, "DSQUIZ_PREFIX": "bridge-system-quiz", "DSQUIZ_DEBUG": "0"}
	try:
		rc = subprocess.run(argv, env=env).returncode
	except KeyboardInterrupt:
		rc = 130
	raise SystemExit(rc)

# serve with OpenTelemetry tracing (see apps/quiz/run-jaeger-tracing.cmd for a local jaeger)
[group('serve')]
[script]
serve-traced *args:
	import os, subprocess

	argv = [
		"uv", "run", "--project", r"{{project}}", "--extra", "telemetry", "--directory", r"{{project}}",
		"opentelemetry-instrument", "litestar", "--app", "app:app", "run", "--port", r"{{port}}",
		*r'''{{args}}'''.split(),
	]
	try:
		rc = subprocess.run(argv, env={**os.environ, "DSQUIZ_OTEL": "1"}).returncode
	except KeyboardInterrupt:
		rc = 130
	raise SystemExit(rc)

# yappi INSTRUMENTS every python call, so the server runs several times slower and the report answers
# "where does the time go", never "how fast is it" (that is what apps/dsquiz-perf measures). Sampling
# was tried first and cannot do this job: py-spy pauses the process to read stacks, and one asyncio
# loop on one core means pausing it IS the outage -- 100Hz against 100 users took the P90 from ~50ms
# to 18s -- while its `--nonblocking` mode loses ~35% of samples to torn reads.
#
#   just serve-profiled                     # then drive load at it
#   curl http://127.0.0.1:5008/debug/yappi   # the report so far
#   curl -X POST .../debug/yappi/reset       # start a clean window (drops the startup work)
#   curl -X POST .../debug/yappi/save        # write .reports/yappi (...).txt + .callgrind
#
# `DSQUIZ_YAPPI_CLOCK=wall` measures elapsed rather than CPU time, which puts the answer route's
# deliberate `asyncio.sleep` at the top and buries everything else -- cpu is the default for that
# reason. Off, none of this exists: no import, no routes, no hooks (see tests/test_profiling.py).
# ---
# serve with the yappi profiler armed (report at /debug/yappi)
[group('serve')]
[script]
serve-profiled *args:
	import os, subprocess

	argv = [
		"uv", "run", "--project", r"{{project}}", "--directory", r"{{project}}", "--extra", "profiling",
		"granian", "--interface", "asgi", "--port", r"{{port}}",
		*r'''{{args}}'''.split(), "app:app",
	]
	env = {**os.environ, "DSQUIZ_YAPPI": "1"}
	try:
		rc = subprocess.run(argv, env=env).returncode
	except KeyboardInterrupt:
		rc = 130  # the shutdown hook writes the report on a polite stop
	raise SystemExit(rc)

