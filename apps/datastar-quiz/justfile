# Files only; the box then runs `uv sync` and restarts its own service -- DEPLOY.md section 4 is the
# full walkthrough.
#
# Unlike the root `just deploy-quiz`, this does NOT flatten: `corpus.py` puts `../quiz` on sys.path,
# the `/media` static router serves `../quiz/completed.jpeg`, and `quiz.bml_docs_dir()` looks two
# levels up for the .bml corpus -- so the repo's relative layout is what is copied.
# ---
# copy the app + apps/quiz + the bml corpus/tools to DEST (default DSQUIZ_DEPLOY_DIR, else X:/quiz-ds/)
[group('deploy')]
[script]
deploy dest=deploy_dir:
	import shutil
	from pathlib import Path

	dest = Path(r"{{dest}}".rstrip("/\\"))
	app, quiz, bml = dest / "apps" / "datastar-quiz", dest / "apps" / "quiz", dest / "bml"
	for directory in (app, quiz, bml):
		directory.mkdir(parents=True, exist_ok=True)

	repo, project = Path(r"{{repo}}"), Path(r"{{project}}")

	def copy(sources, target):
		count = 0
		for source in sorted(sources):
			shutil.copy2(source, target / source.name)
			count += 1
		return count

	# the .bml corpus, at the deploy root because that is where quiz.py looks for it
	copy(repo.glob("*.bml"), dest)
	# the bml tools -- BML_TOOLS_DIRECTORY points here on the box
	copy(Path(r"{{bml_home}}").glob("*.py"), bml)
	# the panel app's domain modules (imported as-is, never copied into this app), the topics files
	# bidfilter reads from beside itself, and the jpeg the /media router serves
	for pattern in ("*.py", "*_topics.toml", "*.jpeg"):
		copy((repo / "apps" / "quiz").glob(pattern), quiz)
	# this app: flat modules and the lock
	copy(project.glob("*.py"), app)
	copy((project / name for name in ("pyproject.toml", "uv.lock")), app)
	# the two asset dirs, replaced WHOLESALE, so a renamed stylesheet or template cannot linger on the
	# box as a stale file that still resolves
	for name in ("static", "templates"):
		shutil.rmtree(app / name, ignore_errors=True)
		shutil.copytree(project / name, app / name)

	print(
		f"deployed to {dest} -- now on the box: cd {dest.name}/apps/datastar-quiz; "
		"uv sync --no-dev; then restart the service"
	)

# payload sizes + SSE frame pacing against a RUNNING server; `--base` defaults to the local dev one.
# Needs `--directory` as well as `--project`: the script path is relative, and `--project` alone
# leaves the cwd wherever just was invoked from.
#   just dsquiz measure --base https://sublime.is/bridge-system-quiz
# ---
# measure payload sizes + SSE frame pacing against a running server
[group('deploy')]
measure *args:
	uv run --project {{project}} --directory {{project}} python tools/measure.py {{args}}

# list the routes litestar has registered
[group('dev')]
routes:
	uv run --project {{project}} --directory {{project}} litestar --app app:app routes

# re-vendor the CSS frameworks the two spikes import (see DESIGN.md); pinned versions, not @latest
[group('assets')]
[script]
vendor-css:
	import urllib.request
	from pathlib import Path

	static = Path(r"{{project}}") / "static"
	sheets = {
		"pico.classless.min.css": "https://cdn.jsdelivr.net/npm/@picocss/pico@2.1.1/css/pico.classless.min.css",
		"bulma.min.css": "https://cdn.jsdelivr.net/npm/bulma@1.0.4/css/bulma.min.css",
	}
	for name, url in sheets.items():
		# written only after the whole body is in hand: a half-downloaded stylesheet still parses,
		# and would sit there looking like a working vendored file
		body = urllib.request.urlopen(url, timeout=60).read()
		(static / name).write_bytes(body)
		print(f"vendored {name} ({len(body):,} bytes)")

# re-vendor static/datastar.js (+ its source map) from the datastar checkout
# (DATASTAR_HOME, else ~/dev/datastar)
#
# The MAP matters: the bundle ends with `//# sourceMappingURL=datastar.js.map`, so opening devtools
# asks for it, and without it the static router raises NotFoundException -- a stack trace in the log
# every time anyone opens devtools. With it, expression errors point into datastar's own sources,
# which is worth 190KB that only devtools ever downloads.
# ---
# re-vendor static/datastar.js + its source map from the datastar checkout (DATASTAR_HOME)
[group('assets')]
[script]
vendor-datastar:
	import shutil
	from pathlib import Path

	bundles = Path(r"{{datastar_home}}") / "bundles"
	static = Path(r"{{project}}") / "static"
	for name in ("datastar.js", "datastar.js.map"):
		source = bundles / name
		if not source.exists():
			raise SystemExit(f"datastar bundle not found at {source}")
		shutil.copy2(source, static / name)
		print(f"vendored {source}")
