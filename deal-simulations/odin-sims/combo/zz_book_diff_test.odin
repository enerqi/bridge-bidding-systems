@(test)
zz_book_diff :: proc(t: ^testing.T) {
	buckets := [5]int{} // |d|<=3, <=8, <=15, ours<<book(>15 low), ours>>book(>15 high)
	line_gap := 0 // ours << book by >15 BUT our double-dummy ceiling reaches book (headroom exists = wrong line)
	model_limit := 0 // ours << book by >15 AND ceiling also below book (our isolated model cannot represent it)
	over := 0 // ours >> book by >15 (engine over-claims vs best-defence book)
	gaps: [dynamic]string; defer delete(gaps)
	overs: [dynamic]string; defer delete(overs)
	n_pts := 0
	sum_abs := 0.0
	for c in book_cases {
		bl := best_line_by_mean(c.n, c.s)
		cen := suit_trick_distribution(c.n, c.s)
		for i in 0 ..< c.nt {
			tg := c.targets[i]
			ours := 100 * p_at_least(bl.dist.p, tg.need)
			ceil := 100 * p_at_least(cen.p, tg.need)
			d := ours - f64(tg.pct)
			ad := abs(d)
			sum_abs += ad
			n_pts += 1
			switch {
			case ad <= 3:
				buckets[0] += 1
			case ad <= 8:
				buckets[1] += 1
			case ad <= 15:
				buckets[2] += 1
			case d < 0:
				buckets[3] += 1
			case:
				buckets[4] += 1
			}
			if d < -15 {
				if ceil >= f64(tg.pct) - 5 {
					line_gap += 1
					if len(gaps) < 45 {
						append(
							&gaps,
							fmt.tprintf(
								"  %-6s need%d book=%d%% ours=%.0f%% ceil=%.0f%% best=%-14s | %s",
								c.decl,
								tg.need,
								tg.pct,
								ours,
								ceil,
								bl.name,
								c.line,
							),
						)
					}
				} else {model_limit += 1}
			}
			if d > 15 {
				over += 1
				if len(overs) < 20 {
					append(
						&overs,
						fmt.tprintf(
							"  %-6s need%d book=%d%% ours=%.0f%% ceil=%.0f%% best=%-14s | %s",
							c.decl,
							tg.need,
							tg.pct,
							ours,
							ceil,
							bl.name,
							c.line,
						),
					)
				}
			}
		}
	}
	fmt.printfln(
		"BOOK DIFF: %d cases, %d target-points, mean|delta|=%.1f%%",
		len(book_cases),
		n_pts,
		sum_abs / f64(max(n_pts, 1)),
	)
	fmt.printfln(
		"  |d|<=3:%d  <=8:%d  <=15:%d  ours<<book:%d  ours>>book:%d",
		buckets[0],
		buckets[1],
		buckets[2],
		buckets[3],
		buckets[4],
	)
	fmt.printfln(
		"  of the %d 'ours<<book': LINE-GAP(ceiling reaches book, wrong line)=%d  MODEL-LIMIT(ceiling also short)=%d ; OVER=%d",
		buckets[3],
		line_gap,
		model_limit,
		over,
	)
	fmt.println("  --- LINE-GAP offenders (headroom exists, our line underperforms) ---")
	for w in gaps {fmt.println(w)}
	fmt.println("  --- OVER (engine claims MORE than best-defence book) ---")
	for w in overs {fmt.println(w)}
	testing.expect(t, len(book_cases) > 0)
}
